{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/hook.mjs\"", "timeout": 30 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/hook.mjs\"", "timeout": 5 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/tool-boundary.sh\"", "timeout": 15, "additionalContextLimit": 0 }] }],
    "Interrupt": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/hook.mjs\"", "timeout": 3 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/hook.mjs\"", "timeout": 3 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/hook.mjs\"", "timeout": 5 }] }]
  }
}
